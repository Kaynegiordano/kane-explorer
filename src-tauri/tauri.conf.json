{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kane Explorer",
  "version": "1.3.3",
  "identifier": "com.kane.explorer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kane Explorer",
        "width": 1200,
        "height": 1190,
        "minWidth": 720,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Kane",
    "copyright": "© 2026 Kane",
    "category": "Utility",
    "shortDescription": "Explorateur de fichiers simple, léger et rapide",
    "longDescription": "Kane Explorer remplace l'Explorateur Windows : onglets, aperçu, glisser-déposer, OneDrive, prompts IA, visionneuse, analyse de l'espace et bien plus.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["French"],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "windows/header.bmp",
        "sidebarImage": "windows/sidebar.bmp",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQxNEE2QzEzNTEzOTNFQzUKUldURlBqbFJFMnhLMGFSbVg2c01HeXZKalFpazNSaTNYVFR5NE1lQWNINFhzOFEyZ0RHbjEvWFUK",
      "endpoints": [
        "https://github.com/Kaynegiordano/kane-explorer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
